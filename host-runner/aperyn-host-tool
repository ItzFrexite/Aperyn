#!/usr/bin/env python3
"""Container-side client for a fixed Aperyn Host Runner tool."""
import json, os, socket, sys
program=os.path.basename(sys.argv[0])
request={'program':program,'args':sys.argv[1:],'cwd':os.getcwd(),'timeout':900}
try:
    sock=socket.socket(socket.AF_UNIX); sock.settimeout(905); sock.connect('/run/aperyn-host-runner.sock'); sock.sendall(json.dumps(request).encode()); sock.shutdown(socket.SHUT_WR)
    response=json.loads(b''.join(iter(lambda:sock.recv(65536),b'')).decode())
    sys.stdout.write(response.get('stdout','')); sys.stderr.write(response.get('stderr',''))
    if not response.get('ok'): sys.stderr.write('Aperyn Host Runner: '+response.get('error','unavailable')+'\n'); raise SystemExit(127)
    raise SystemExit(int(response.get('code',1)))
except FileNotFoundError:
    sys.stderr.write('Aperyn Host Runner is not installed. Run ./ollama-control up on the host.\n'); raise SystemExit(127)
