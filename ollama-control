#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"

usage(){ echo "Usage: ./ollama-control {up|down|status|preflight|install-helper|install-host-runner}"; }
ensure_published_image(){
  python3 <<'PY'
from pathlib import Path
p = Path('.env')
text = p.read_text()
legacy = 'OLLAMA_CONTROL_IMAGE=ollama-control:local'
if legacy in text:
    p.write_text(text.replace(legacy, 'OLLAMA_CONTROL_IMAGE=ghcr.io/itzfrexite/aperyn:latest'))
    print('Updated the legacy local image setting to the published Aperyn image.')
PY
}
prepare_agent_runtime(){
  local runtime_uid runtime_gid workspace mnt_workspace
  runtime_uid=$(id -u)
  runtime_gid=$(id -g)
  python3 - "$runtime_uid" "$runtime_gid" <<'PY'
from pathlib import Path
import sys
p = Path('.env')
text = p.read_text()
uid, gid = sys.argv[1:3]
text = text.replace('APERYN_AGENT_UID=1000', 'APERYN_AGENT_UID='+uid, 1)
text = text.replace('APERYN_AGENT_GID=1000', 'APERYN_AGENT_GID='+gid, 1)
p.write_text(text)
PY
  workspace=$(grep -E '^APERYN_AGENT_WORKSPACE=' .env | tail -n1 | cut -d= -f2- || true)
  workspace=${workspace:-$HOME}
  case "$workspace" in
    /) echo "Refusing to mount host root as the Agent workspace. Choose a safe parent such as $HOME." >&2; exit 1 ;;
  esac
  mnt_workspace=$(grep -E '^APERYN_AGENT_MNT=' .env | tail -n1 | cut -d= -f2- || true)
  mnt_workspace=${mnt_workspace:-/mnt}
  case "$mnt_workspace" in
    /) echo "Refusing to mount host root as APERYN_AGENT_MNT. Choose a safe mounted-storage tree such as /mnt." >&2; exit 1 ;;
  esac
  if [ ! -d "$mnt_workspace" ]; then
    echo "Agent mounted-storage boundary does not exist: $mnt_workspace" >&2
    echo "Create it first or set APERYN_AGENT_MNT to an existing safe directory." >&2
    exit 1
  fi
  mkdir -p data/agent "$workspace"
  if [ ! -w "$workspace" ]; then
    echo "Agent workspace is not writable by UID $runtime_uid: $workspace" >&2
    echo "Choose a writable APERYN_AGENT_WORKSPACE or correct its ownership." >&2
    exit 1
  fi
}
sync_host_token(){
  local token_file=/var/lib/ollama-control/helper.token token
  if ! sudo test -s "$token_file"; then return 1; fi
  token=$(sudo cat "$token_file")
  python3 - "$token" <<'PY'
from pathlib import Path
import sys
p=Path('.env'); token=sys.argv[1]; lines=p.read_text().splitlines() if p.exists() else []
out=[]; found=False
for line in lines:
    if line.startswith('OLLAMA_CONTROL_HELPER_TOKEN='):
        if not found: out.append('OLLAMA_CONTROL_HELPER_TOKEN='+token); found=True
    else: out.append(line)
if not found: out += ['', '# Synchronized from the host-level helper identity; never commit this file.', 'OLLAMA_CONTROL_HELPER_TOKEN='+token]
p.write_text('\n'.join(out)+'\n')
PY
}
helper_auth_ok(){
  local token
  token=$(grep -E '^OLLAMA_CONTROL_HELPER_TOKEN=' .env | tail -n1 | cut -d= -f2- || true)
  [ -n "$token" ] || return 1
  curl -fsS --max-time 3 -H "Authorization: Bearer $token" http://127.0.0.1:11436/v1/status >/dev/null 2>&1
}

command=${1:-}
case "$command" in
  up)
    test -f .env || cp .env.example .env
    ensure_published_image
    prepare_agent_runtime
    if ! systemctl is-active --quiet "aperyn-host-runner@${USER}.socket" 2>/dev/null; then
      echo "Installing or repairing the non-root Aperyn Host Runner."
      bash scripts/install-host-runner.sh
    fi
    curl -fsS --max-time 4 http://127.0.0.1:11434/api/version >/dev/null || { echo "Native Ollama is not reachable at 127.0.0.1:11434" >&2; exit 1; }
    if systemctl is-active --quiet ollama-control-helper 2>/dev/null && helper_auth_ok; then
      echo "Host helper is active and its identity is verified."
    elif systemctl is-active --quiet ollama-control-helper 2>/dev/null; then
      echo "Host helper authentication needs repair (sudo required once)."
      if sudo test -s /var/lib/ollama-control/helper.token 2>/dev/null; then
        sync_host_token
        helper_auth_ok || bash scripts/install-performance-helper.sh
      else
        bash scripts/install-performance-helper.sh
      fi
    else
      echo "Installing or repairing the allow-listed host helper."
      bash scripts/install-performance-helper.sh
    fi
    bash scripts/detect-hardware.sh || true
    bash scripts/preflight-check.sh
    docker compose up -d
    docker compose ps
    ;;
  down) docker compose down ;;
  status) docker compose ps ;;
  preflight) bash scripts/preflight-check.sh ;;
  install-helper) bash scripts/install-performance-helper.sh ;;
  install-host-runner) bash scripts/install-host-runner.sh ;;
  *) usage; exit 2 ;;
esac
