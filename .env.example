# Aperyn - host-installed Ollama + Dockerized WebUI/proxy
# --------------------------------------------------------------
# Your existing Ollama systemd/native service. It can stay private on loopback.
# This is also the default used when Settings -> Ollama endpoint is left blank.
OLLAMA_API=http://127.0.0.1:11434

# WebUI host port. Docker publishes HOST:15736 -> CONTAINER:3000 by default.
# Change 15736 to any unused high port if you prefer another one.
MANAGER_PORT=15736
MANAGER_BIND=0.0.0.0

# Published Aperyn image. Compose pulls this automatically; override it to pin
# a release tag such as ghcr.io/itzfrexite/aperyn:1.27.0.
OLLAMA_CONTROL_IMAGE=ghcr.io/itzfrexite/aperyn:latest

# Private coding-agent runtime. It is not exposed on a host port. Pin both
# image settings to the same release for reproducible updates.
APERYN_AGENT_IMAGE=ghcr.io/itzfrexite/aperyn-agent:latest

# Host directory available to Agent tasks. When blank, Compose uses the home
# directory of the account running Docker Compose, allowing the picker to move
# between normal project folders. Set an absolute path to use another safe
# parent directory. Never use / or a directory containing docker.sock.
APERYN_AGENT_WORKSPACE=
# Root-level mounted storage is exposed as a separate, explicit picker root.
# Leave this at /mnt for normal Linux hosts, or point it at another safe host
# mount. It appears inside the Agent container as /mnt; host / is never mounted.
APERYN_AGENT_MNT=/mnt
APERYN_AGENT_CONTEXT_LIMIT=98304
APERYN_AGENT_UID=1000
APERYN_AGENT_GID=1000

# Drop-in Ollama API + telemetry endpoint for OpenCode / Continue / Aider / etc.
# Normal Ollama paths are preserved: http://SERVER:11435/api/chat, etc.
PROXY_PORT=11435

# Optional Hugging Face token. Leave blank for public GGUF repositories.
# Set this if you want to browse/install gated repositories you have access to.
HF_TOKEN=

# IMPORTANT MTP NOTE
# Remove global host-service overrides such as:
#   LLAMA_ARG_SPEC_TYPE=draft-mtp
#   LLAMA_ARG_SPEC_DRAFT_N_MAX=2
# Aperyn saves draft_num_predict per model and capability-gates MTP.

# Optional host performance helper. Leave blank until you install it with:
#   make install-helper
# The installer generates a strong token here automatically. The helper binds
# only to 127.0.0.1:11436 and can only change an allow-list of Ollama settings.
OLLAMA_CONTROL_HELPER_TOKEN=
OLLAMA_CONTROL_HELPER_URL=http://127.0.0.1:11436

# Set true when the WebUI is served exclusively through HTTPS.
SESSION_COOKIE_SECURE=false
